[35.949491, "o", "\u001b[94m  INSTALLATION\u001b[m\r\n\u001b[?25l    \u001b[35m\u280b\u001b[m CLI binary \u2014 checking\u2026 \u001b[90m(0s)\u001b[m\r\n"]
[35.949626, "o", "\u001b[1A\r\u001b[K"]
[35.94973, "o", "\u001b[?25h    \u001b[32m\u2713\u001b[m CLI binary\u001b[90m \u2014 \u001b[mfound"]
[35.949759, "o", "\r\n"]
[35.949823, "o", "        \u001b[90m/usr/bin/sbx\u001b[m\r\n\u001b[?25l"]
[35.950163, "o", "    \u001b[35m\u280b\u001b[m Binary version \u2014 checking\u2026 \u001b[90m(0s)\u001b[m\r\n"]

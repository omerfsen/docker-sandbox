[59.663614, "o", "\r\n\u001b[36m# Remove the Anthropic key from Lab 06 when you are done: sbx secret rm anthropic -f\u001b[0m\r\n\r\n\u001b[36m# Sign out (stops running sandboxes): sbx logout\u001b[0m\r\n\r\n\u001b[36m# Back to a fresh install (deletes ALL sandboxes, images, policies, secrets): sbx reset\u001b[0m\r\n\r\n\u001b[36m# Uninstall: sudo apt-mark unhold docker-sbx && sudo apt-get purge -y docker-sbx\u001b[0m\r\n"]
